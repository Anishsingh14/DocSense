# DocSense — Local Environment Variables
# DO NOT commit this file to GitHub. It is already excluded via .gitignore.
# Never paste real key values into chat, screenshots, or commit messages.

# --- Google Gemini (used for Stage 3 vision analysis, free tier) ---
GEMINI_API_KEY=paste-your-new-gemini-key-here

# --- Anthropic Claude (add later, once billing is set up) ---
# ANTHROPIC_API_KEY=

# --- Voyage AI embeddings (add later, for Stage 4, if using the paid embedding option) ---
# VOYAGE_API_KEY=

# --- Qdrant (only needed if using a hosted/cloud Qdrant instance instead of local Docker) ---
# QDRANT_URL=
# QDRANT_API_KEY=
