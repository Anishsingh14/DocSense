# DocSense — Local Environment Variables
# DO NOT commit the real .env file to GitHub. It is already excluded via .gitignore.
# Never paste real key values into chat, screenshots, or commit messages.

# --- Google Gemini API keys (multi-key rotation for free-tier quota management) ---
# Each key below MUST belong to a DIFFERENT Google Cloud project, since Gemini's
# free-tier rate limits (20 requests/day on gemini-2.5-flash) are applied per
# project, not per key or per account. Using multiple keys from the SAME project
# does NOT increase your quota.
#
# See TDR.md Section 2d for the full documented reasoning behind this setup.
#
# You do not need all 7 slots filled to run the project — even just
# GEMINI_API_KEY alone is enough to get started. The extra keys simply give
# the rotation logic more quota to fall back on if one is exhausted.

GEMINI_API_KEY=paste-your-original-gemini-key-here
GEMINI_API_KEY_2=paste-your-rag2-key-here
GEMINI_API_KEY_3=paste-your-rag3-key-here
GEMINI_API_KEY_4=paste-your-rag4-key-here
GEMINI_API_KEY_5=paste-your-rag5-key-here
GEMINI_API_KEY_6=paste-your-rag6-key-here
GEMINI_API_KEY_7=paste-your-rag7-key-here

# --- Anthropic Claude (optional, only if billing is set up later) ---
# ANTHROPIC_API_KEY=

# --- Voyage AI embeddings (optional, only if switching back from Gemini embeddings) ---
# VOYAGE_API_KEY=

# --- Qdrant (only needed if using a hosted/cloud Qdrant instance instead of local embedded mode) ---
# QDRANT_URL=
# QDRANT_API_KEY=
